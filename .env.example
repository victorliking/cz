# Database (Neon serverless Postgres)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/homematch?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# AI (Anthropic Claude)
ANTHROPIC_API_KEY="sk-ant-..."

# --- Security ---

# MLS PIN IDX feed credentials. Required by the sync-mls cron route — it fails
# closed (HTTP 500, no sync) if either is missing. NEVER commit real values.
MLS_PIN_USERNAME="your-mlspin-username"
MLS_PIN_PASSWORD="your-mlspin-password"

# Shared secret for the Vercel cron sync-mls endpoint. Sent by the scheduler as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated allowlist of emails permitted to self-escalate to the AGENT
# role via /api/auth/set-role. Empty/unset = no one can become an agent (fail
# closed). Example: "agent1@brokerage.com,agent2@brokerage.com"
AGENT_ALLOWLIST=""

# HMAC secret for signing public intake links (/intake/<profileId>?t=<token>).
# Required to mint and verify intake tokens; if unset, public intake routes
# fail closed (links won't validate or submit). Generate with:
# openssl rand -base64 32
INTAKE_TOKEN_SECRET="generate-with-openssl-rand-base64-32"
